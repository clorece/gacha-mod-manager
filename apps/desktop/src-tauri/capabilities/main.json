{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call GMM's own commands and nothing else: no core:default, no plugin permissions (docs/04-security.md, R5). Keep in step with build.rs.",
  "windows": ["main"],
  "permissions": [
    "allow-games",
    "allow-statuses",
    "allow-catalog-list",
    "allow-catalog-search",
    "allow-catalog-mod",
    "allow-catalog-updates",
    "allow-catalog-categories",
    "allow-catalog-featured",
    "allow-catalog-stats",
    "allow-prepare-install",
    "allow-install",
    "allow-queue-install",
    "allow-queue-change-file",
    "allow-queue-jobs",
    "allow-queue-watch",
    "allow-queue-pause",
    "allow-queue-resume",
    "allow-queue-cancel",
    "allow-queue-dismiss",
    "allow-queue-clear-finished",
    "allow-startup-check",
    "allow-library",
    "allow-switch-version",
    "allow-rollback-files",
    "allow-set-enabled",
    "allow-uninstall-preview",
    "allow-uninstall",
    "allow-conflicts",
    "allow-storage",
    "allow-clear-download-cache",
    "allow-clear-http-cache",
    "allow-clear-image-cache",
    "allow-error-log",
    "allow-clear-error-log",
    "allow-open-log-folder",
    "allow-log-ui-error",
    "allow-bug-report-draft",
    "allow-open-bug-report",
    "allow-network-status",
    "allow-launch-plan",
    "allow-launch",
    "allow-settings",
    "allow-preferences",
    "allow-set-preferences",
    "allow-pick-xxmi-folder",
    "allow-clear-xxmi-folder",
    "allow-pick-game-folder",
    "allow-remove-game-folder",
    "allow-open-mod-page",
    "allow-open-xxmi-releases",
    "allow-open-link",
    "allow-open-mod-folder",
    "allow-mod-keybindings",
    "allow-adopt-candidates",
    "allow-adopt",
    "allow-drop-watch",
    "allow-pick-archive",
    "allow-prepare-local",
    "allow-install-local",
    "allow-discard-local",
    "allow-profiles",
    "allow-profile-save",
    "allow-profile-apply",
    "allow-profile-rename",
    "allow-profile-delete",
    "allow-profile-export",
    "allow-profile-import"
  ]
}
