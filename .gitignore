# Rust
/target/
**/target/

# Node / frontend
node_modules/
dist/
.vite/
.pnpm-store/
*.tsbuildinfo
coverage/
test-results/
playwright-report/

# Tauri
apps/desktop/src-tauri/gen/
# Release builds: the installer staging folder and signed / unsigned artifacts from CI runs
/out/
/signed/
/unsigned/

# Tauri: generated by tauri-build from build.rs on every build
apps/desktop/src-tauri/permissions/autogenerated/

# Built programs and installers (they come from CI and releases, never from the repo)
*.exe
*.dll
*.pdb
*.msi
*.msix
*.appx
*.AppImage

# GMM's own data, if a test or a portable run puts it here (GMM_HOME), and logs
gmm.db
*.db
*.db-shm
*.db-wal
*.sqlite
*.log

# Mod archives: real mods are other people's work. Tests build their archives in code.
*.zip
*.7z
*.rar

# Secrets: environment files, signing keys and certificates
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
# Tauri update / minisign keys, if ever generated here
*.key.pub
.tauri/
*.p12
*.cer
*.crt

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
*.lnk

# Claude Code: personal settings and notes (launch.json is shared)
.claude/settings.local.json
CLAUDE.local.md

# Internal research notes (keep out of the public repo)
docs/research/
